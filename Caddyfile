# HTTPS for the study. Caddy gets and renews the Let's Encrypt certificate for DOMAIN by itself.
#
# Privacy: no visitor IP address may ever be written to disk.
#  - There is no `log` directive in the site block, so Caddy writes no access log. Do not add one.
#  - The global block below also silences the loggers that would otherwise record the visitor's
#    address and the requested URL when a request fails (for example while the app restarts)
#    or a TLS handshake is refused.
# Certificate and startup messages are still logged; they contain no visitor data.

{
	log default {
		exclude http.log.access http.log.error http.stdlib
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	request_body {
		max_size 100MB
	}

	reverse_proxy app:8000
}
