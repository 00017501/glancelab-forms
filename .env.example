# Copy this file to .env and fill it in. Never commit .env.

# ----- Admin login (the one and only admin) -----
ADMIN_USERNAME=researcher
# At least 8 characters. Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=

# ----- Public address -----
# The domain that points at this server, without https://  (for example study.example.com).
# Caddy gets the HTTPS certificate for it automatically.
DOMAIN=

# ----- Image storage -----
# By default images go to the SeaweedFS container that docker-compose starts.
# Pick any two random strings; they only protect the internal storage service.
# Generate each with:  openssl rand -hex 16
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=glancelab

# To use AWS S3 instead, create a private bucket, put its name in S3_BUCKET, put an IAM
# user's keys above, and uncomment these two lines (the empty endpoint means "real AWS"):
# S3_ENDPOINT_URL=
# S3_REGION=eu-west-2

# ----- Optional tuning (defaults shown) -----
# MAX_UPLOAD_MB=15
# IMAGE_MAX_EDGE_PX=2400
# ACTIVE_SESSION_MINUTES=30
# ADMIN_SESSION_HOURS=12
